{
  "name": "aranyam-matrimony-backend",
  "version": "1.0.0",
  "description": "Resilient, scale-ready event-driven microservices backend for Aranyam Matrimony",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc && prisma generate",
    "start": "node dist/index.js",
    "dev": "ts-node-esm src/index.ts",
    "simulate": "ts-node-esm src/simulate_outage.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma db push"
  },
  "dependencies": {
    "@prisma/client": "^5.12.1",
    "bullmq": "^5.7.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ioredis": "^5.3.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.7",
    "prisma": "^5.12.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
