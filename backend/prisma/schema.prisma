datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id             String   @id // Corresponds directly to Firebase Auth UID
  name           String
  age            Int
  city           String
  country        String
  bio            String
  interests      String[] // Native Postgres text array
  verifiedStatus Boolean  @default(false)
  values         String[] // Native Postgres text array
  image          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([city])
  @@index([verifiedStatus])
}

model Like {
  id         String   @id @default(uuid())
  fromUserId String
  toUserId   String
  createdAt  DateTime @default(now())

  @@unique([fromUserId, toUserId])
  @@index([fromUserId])
  @@index([toUserId])
}

model Match {
  matchId   String   @id // Format: uid1_uid2 (alphabetically sorted)
  user1Id   String
  user2Id   String
  status    String   @default("matched") // "liked" | "matched"
  createdAt DateTime @default(now())

  @@index([user1Id])
  @@index([user2Id])
}

model Message {
  id        String   @id // Direct copy of Firestore Message ID or UUID
  matchId   String
  senderId  String
  text      String
  createdAt DateTime

  @@index([matchId])
}

model SyncAuditLog {
  id           String   @id @default(uuid())
  entityType   String   // "USER" | "LIKE" | "MATCH" | "MESSAGE"
  entityId     String
  action       String   // "CREATE" | "UPDATE" | "DELETE"
  status       String   // "SUCCESS" | "FAILED" | "RETRIED"
  attempts     Int      @default(1)
  errorMessage String?
  createdAt    DateTime @default(now())

  @@index([entityType, entityId])
  @@index([status])
}
